# Plesk / Apache — serve the Next.js static 404 page
# (generated as /404.html during `next build` with output: "export")

Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS (optional; remove if SSL is handled elsewhere)
  # RewriteCond %{HTTPS} !=on
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Custom error pages (overrides Plesk default)
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html

# Caching for static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

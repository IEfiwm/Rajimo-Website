# Plesk / Apache — custom error documents
# Pages live in /error-pages/ and are mirrored to /error_docs/ on deploy.

Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
</IfModule>

# ── HTTP error pages ──────────────────────────────────────────────
ErrorDocument 403 /error-pages/firewall.html
ErrorDocument 404 /404.html
ErrorDocument 410 /error-pages/link-expired.html
ErrorDocument 429 /error-pages/rate-limit.html
ErrorDocument 500 /error-pages/origin-502.html
ErrorDocument 502 /error-pages/origin-502.html
ErrorDocument 503 /error-pages/maintenance.html
ErrorDocument 504 /error-pages/origin-502.html

# Caching for static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
